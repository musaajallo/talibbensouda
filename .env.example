APP_NAME="Talib Bensouda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talibbensouda
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disk that Spatie Media Library writes uploaded images to. `public` keeps
# files local (storage/app/public, served via `php artisan storage:link`);
# set to `s3` plus the AWS_* block below to move them off the box.
MEDIA_DISK=public
# Generate image conversions / responsive images on the queue (needs a worker).
QUEUE_CONVERSIONS_BY_DEFAULT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (set MAIL_MAILER=resend in production)
RESEND_API_KEY=

# Seeded admin account (Database\Seeders\AdminUserSeeder). Rotate the password
# before deploying anywhere shared.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password"

# Where ops notifications (backups, failed jobs, health) are sent.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
