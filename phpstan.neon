includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/seeders/
        - routes/

    level: 5

    excludePaths:
        - bootstrap/cache/*

    ignoreErrors:
        # Breeze emits User|null where MustVerifyEmail is expected — runtime guard handles it.
        - '#Parameter \#1 \$user of class Illuminate\\Auth\\Events\\Verified constructor expects#'
        # MediaLibrary config references the Pro version's TemporaryUpload class.
        - '#Class Spatie\\MediaLibraryPro\\Models\\TemporaryUpload not found#'
